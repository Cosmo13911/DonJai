# Supabase (ดูขั้นตอนการสร้างและตั้งค่าได้ที่ docs/supabase-setup.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# คีย์สำหรับเซ็นคุกกี้ปลดล็อกของขวัญฝั่งผู้รับ และแฮช IP สำหรับ rate limit
# หากยังไม่ตั้ง ค่าเริ่มต้นฝั่งเซิร์ฟเวอร์จะใช้ SUPABASE_SERVICE_ROLE_KEY ชั่วคราวได้
DONJAI_SESSION_SECRET=

# URL หลักของเว็บ (เช่น http://localhost:4173 หรือ https://donjai.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:4173
